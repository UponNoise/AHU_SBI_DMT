---
import { coursePath, siteData } from '../lib/site-data';

interface Props {
  major: 'DMT' | 'AMS';
}

const { major } = Astro.props;
const majorData = siteData.majors[major];
const coursesBySlug = new Map(siteData.courses.map((course) => [course.slug, course]));
const groups = majorData.groups.filter((group) => !group.hidden);
const uniqueCourses = new Set(groups.flatMap((group) => group.courses));
const availableCourses = [...uniqueCourses].filter(
  (slug) => coursesBySlug.get(slug)?.hasResources,
).length;
---

<div class="curriculum-view">
  <div class="curriculum-summary">
    <div>
      <p class="eyebrow">{major} STUDY PATH</p>
      <h2>按学期浏览课程</h2>
      <p>课程出现在哪个学期、是否已有资料，在同一页就能判断。</p>
    </div>
    <dl>
      <div>
        <dt>课程数</dt>
        <dd>{uniqueCourses.size}</dd>
      </div>
      <div>
        <dt>已有资料</dt>
        <dd>{availableCourses}</dd>
      </div>
      <div>
        <dt>学期分组</dt>
        <dd>{groups.length}</dd>
      </div>
    </dl>
  </div>

  <nav class="semester-jump" aria-label="跳转到学期">
    {groups.map((group, index) => (
      <a href={`#semester-${index + 1}`}>{group.name}</a>
    ))}
  </nav>

  <div class="semester-sections">
    {groups.map((group, index) => (
      <section id={`semester-${index + 1}`} class="semester-section">
        <div class="semester-section__heading">
          <div>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h2>{group.name}</h2>
          </div>
          <p>{group.availableCourses}/{group.courses.length} 门已有资料</p>
        </div>
        <div class="semester-course-grid">
          {group.courses.map((slug) => {
            const course = coursesBySlug.get(slug);
            if (!course) return null;
            return (
              <a class="semester-course" href={coursePath(course.slug)}>
                <div>
                  <span>{course.displayCode || '专题课程'}</span>
                  <h3>{course.name}</h3>
                </div>
                {course.hasResources ? (
                  <strong>{course.totalFiles} 个文件</strong>
                ) : (
                  <strong class="is-empty">暂无资料</strong>
                )}
              </a>
            );
          })}
        </div>
      </section>
    ))}
  </div>
</div>
