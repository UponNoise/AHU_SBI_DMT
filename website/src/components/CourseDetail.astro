---
import { majorName, siteData, sitePath } from '../lib/site-data';

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const course = siteData.courses.find((item) => item.slug === slug);
if (!course) throw new Error(`Unknown course slug: ${slug}`);

const placementLabels = course.placements.map((placement) => ({
  ...placement,
  label: `${majorName(placement.major)} · ${placement.group}`,
  href: sitePath(`curricula/${placement.major.toLowerCase()}/`),
}));
---

<div class="course-detail">
  <a class="back-link" href={sitePath('courses/')}>← 返回全部课程</a>

  <section class={`course-status ${course.hasResources ? 'course-status--available' : ''}`}>
    <div>
      <p class="eyebrow">{course.displayCode || 'SPECIAL TOPIC'}</p>
      <h2>{course.hasResources ? `已收录 ${course.totalFiles} 个文件` : '课程已建档，等待首份资料'}</h2>
      <p>
        {course.hasResources
          ? '选择下方资料分类，将前往 GitHub 查看目录和下载文件。'
          : '你仍可以查看课程信息，或前往贡献指南补充资料。'}
      </p>
    </div>
    <a href={course.githubUrl} target="_blank" rel="noreferrer">在 GitHub 查看课程目录 ↗</a>
  </section>

  {course.note && <aside class="course-note"><strong>课程说明</strong><p>{course.note}</p></aside>}

  <section class="detail-section" aria-labelledby="course-meta-title">
    <div class="detail-section__heading">
      <p class="eyebrow">COURSE PROFILE</p>
      <h2 id="course-meta-title">课程信息</h2>
    </div>
    <dl class="course-facts">
      <div>
        <dt>课程代码</dt>
        <dd>{course.displayCode || '—'}</dd>
      </div>
      <div>
        <dt>学分</dt>
        <dd>{course.credits ?? '—'}</dd>
      </div>
      <div>
        <dt>石溪认证</dt>
        <dd>{course.certification || '—'}</dd>
      </div>
      <div>
        <dt>前置课程</dt>
        <dd>{course.prerequisite || '—'}</dd>
      </div>
    </dl>

    {placementLabels.length > 0 && (
      <div class="placement-block">
        <h3>仓库课表归属</h3>
        <div class="placement-links">
          {placementLabels.map((placement) => (
            <a href={placement.href}>{placement.label}</a>
          ))}
        </div>
      </div>
    )}

    {Object.keys(course.transferRequirements).length > 0 && (
      <div class="requirement-grid">
        {Object.entries(course.transferRequirements).map(([major, requirement]) => (
          <div>
            <span>{majorName(major)}转专业参考</span>
            <strong>{requirement}</strong>
          </div>
        ))}
      </div>
    )}
  </section>

  <section class="detail-section" aria-labelledby="resource-title">
    <div class="detail-section__heading detail-section__heading--row">
      <div>
        <p class="eyebrow">RESOURCE SHELF</p>
        <h2 id="resource-title">可用资料</h2>
      </div>
      {course.hasResources && <span>{course.totalFiles} 个文件</span>}
    </div>

    {course.categories.length > 0 ? (
      <div class="resource-category-grid">
        {course.categories.map((category) => (
          <a href={category.githubUrl} target="_blank" rel="noreferrer">
            <span>{category.name}</span>
            <strong>{category.count}</strong>
            <small>查看目录 ↗</small>
          </a>
        ))}
      </div>
    ) : (
      <div class="no-resources">
        <span aria-hidden="true">＋</span>
        <div>
          <h3>这里还没有资料</h3>
          <p>如果你手上有可分享的课件、练习或复习资料，欢迎补充。</p>
        </div>
        <a href={sitePath('contribute/')}>查看贡献方式</a>
      </div>
    )}
  </section>

  <footer class="course-disclaimer">
    <p>
      课程信息参考
      <a href={siteData.officialSource.url}>{siteData.officialSource.title}</a>；资料仅供学习参考，以当学期学院通知为准。
    </p>
  </footer>
</div>
