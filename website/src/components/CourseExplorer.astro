---
import { coursePath, majorName, siteData } from '../lib/site-data';

const courses = [...siteData.courses].sort((a, b) => {
  if (a.hasResources !== b.hasResources) return a.hasResources ? -1 : 1;
  return a.name.localeCompare(b.name, 'zh-CN');
});
const majors = Object.entries(siteData.majors);
const groups: string[] = [];
for (const [, major] of majors) {
  for (const group of major.groups) {
    if (!group.hidden && !groups.includes(group.name)) groups.push(group.name);
  }
}
const categories = siteData.materialCategories.filter((category) =>
  courses.some((course) => course.categories.some((item) => item.name === category)),
);
---

<div class="course-explorer" data-course-explorer>
  <header class="explorer-intro">
    <div>
      <p class="eyebrow">COURSE FINDER</p>
      <h2>先搜索，再把范围缩小</h2>
      <p>筛选结果会同步到地址栏，复制当前链接即可分享同一组课程。</p>
    </div>
    <div class="explorer-intro__count">
      <strong>{siteData.stats.courses}</strong>
      <span>门课程已建档</span>
    </div>
  </header>

  <form class="course-filters" data-filter-form method="get" role="search">
    <div class="filter-search">
      <label for="course-query">课程名称或代码</label>
      <div class="filter-search__control">
        <input
          id="course-query"
          name="q"
          type="search"
          placeholder="例如：数据结构、YJ40203、ENG 194"
          autocomplete="off"
          data-filter="query"
        />
        <button type="button" data-clear-query aria-label="清空搜索">清除</button>
      </div>
    </div>

    <div class="filter-grid">
      <label>
        <span>专业</span>
        <select name="major" data-filter="major">
          <option value="">全部专业</option>
          {majors.map(([key]) => <option value={key}>{majorName(key)}</option>)}
        </select>
      </label>
      <label>
        <span>学期</span>
        <select name="semester" data-filter="semester">
          <option value="">全部学期</option>
          {groups.map((group) => <option value={group}>{group}</option>)}
        </select>
      </label>
      <label>
        <span>资料类型</span>
        <select name="category" data-filter="category">
          <option value="">全部类型</option>
          {categories.map((category) => <option value={category}>{category}</option>)}
        </select>
      </label>
      <label>
        <span>库存状态</span>
        <select name="status" data-filter="status">
          <option value="">全部课程</option>
          <option value="available">已有资料</option>
          <option value="empty">等待补充</option>
        </select>
      </label>
    </div>

    <div class="filter-toolbar">
      <div class="active-filters" data-active-filters aria-label="当前筛选条件"></div>
      <div class="filter-toolbar__actions">
        <label>
          <span>排序</span>
          <select name="sort" data-filter="sort">
            <option value="resources">资料数量</option>
            <option value="code">课程代码</option>
            <option value="name">课程名称</option>
          </select>
        </label>
        <button type="reset" data-reset-filters>重置筛选</button>
      </div>
    </div>
  </form>

  <div class="result-summary" aria-live="polite" aria-atomic="true">
    <p><strong data-result-count>{courses.length}</strong> 门课程符合条件</p>
    <span data-result-hint>已有资料的课程优先显示</span>
  </div>

  <div class="course-card-grid" data-course-list data-pagefind-ignore>
    {courses.map((course) => {
      const placementMajors = [...new Set(course.placements.map((item) => item.major))];
      const placementGroups = [...new Set(course.placements.map((item) => item.group))];
      const categoryNames = course.categories.map((category) => category.name);
      return (
        <a
          class="course-card"
          href={coursePath(course.slug)}
          aria-label={`查看${course.name}课程详情`}
          data-course-card
          data-search={course.searchText}
          data-majors={placementMajors.join('|')}
          data-semesters={placementGroups.join('|')}
          data-categories={categoryNames.join('|')}
          data-status={course.hasResources ? 'available' : 'empty'}
          data-files={course.totalFiles}
          data-name={course.name}
          data-code={course.displayCode || course.slug}
        >
          <div class="course-card__topline">
            <span class="course-code">{course.displayCode || '专题课程'}</span>
            {course.hasResources ? (
              <span class="stock-badge stock-badge--available">{course.totalFiles} 个文件</span>
            ) : (
              <span class="stock-badge">等待补充</span>
            )}
          </div>
          <h2 title={course.name}>{course.name}</h2>
          <div class="course-card__tags">
            {placementMajors.map((major) => <span>{majorName(major)}</span>)}
            {placementGroups.slice(0, 2).map((group) => <span>{group}</span>)}
          </div>
          <p class="course-card__categories">
            {course.categories.length
              ? course.categories.map((item) => `${item.name} ${item.count}`).join(' · ')
              : '课程信息已建档，暂无资料分类'}
          </p>
          <span class="course-card__action">
            查看课程详情 <span aria-hidden="true">→</span>
          </span>
        </a>
      );
    })}
  </div>

  <div class="empty-results" data-empty-results hidden>
    <span aria-hidden="true">○</span>
    <h2>没有找到匹配课程</h2>
    <p>试试缩短关键词，或清除一个筛选条件。</p>
    <button type="button" data-empty-reset>显示全部课程</button>
  </div>
</div>

<script>
  const explorer = document.querySelector<HTMLElement>('[data-course-explorer]');

  if (explorer) {
    const form = explorer.querySelector<HTMLFormElement>('[data-filter-form]')!;
    const queryInput = form.querySelector<HTMLInputElement>('[data-filter="query"]')!;
    const majorSelect = form.querySelector<HTMLSelectElement>('[data-filter="major"]')!;
    const semesterSelect = form.querySelector<HTMLSelectElement>('[data-filter="semester"]')!;
    const categorySelect = form.querySelector<HTMLSelectElement>('[data-filter="category"]')!;
    const statusSelect = form.querySelector<HTMLSelectElement>('[data-filter="status"]')!;
    const sortSelect = form.querySelector<HTMLSelectElement>('[data-filter="sort"]')!;
    const cards = Array.from(explorer.querySelectorAll<HTMLElement>('[data-course-card]'));
    const list = explorer.querySelector<HTMLElement>('[data-course-list]')!;
    const count = explorer.querySelector<HTMLElement>('[data-result-count]')!;
    const hint = explorer.querySelector<HTMLElement>('[data-result-hint]')!;
    const activeFilters = explorer.querySelector<HTMLElement>('[data-active-filters]')!;
    const empty = explorer.querySelector<HTMLElement>('[data-empty-results]')!;

    const normalize = (value: string) => value.trim().toLocaleLowerCase('zh-CN');

    const controls = {
      q: queryInput,
      major: majorSelect,
      semester: semesterSelect,
      category: categorySelect,
      status: statusSelect,
      sort: sortSelect,
    };

    function hydrateFromUrl() {
      const params = new URLSearchParams(window.location.search);
      for (const [key, control] of Object.entries(controls)) {
        const fallback = key === 'sort' ? 'resources' : '';
        control.value = params.get(key) ?? fallback;
      }
    }

    function updateUrl() {
      const params = new URLSearchParams();
      for (const [key, control] of Object.entries(controls)) {
        if (control.value && !(key === 'sort' && control.value === 'resources')) {
          params.set(key, control.value);
        }
      }
      const query = params.toString();
      history.replaceState(null, '', `${window.location.pathname}${query ? `?${query}` : ''}`);
    }

    function renderActiveFilters() {
      activeFilters.replaceChildren();
      const labels: Array<[keyof typeof controls, string]> = [
        ['q', queryInput.value ? `关键词：${queryInput.value}` : ''],
        [
          'major',
          majorSelect.value
            ? `专业：${majorSelect.selectedOptions[0]?.textContent ?? majorSelect.value}`
            : '',
        ],
        ['semester', semesterSelect.value ? `学期：${semesterSelect.value}` : ''],
        ['category', categorySelect.value ? `类型：${categorySelect.value}` : ''],
        [
          'status',
          statusSelect.value
            ? `状态：${statusSelect.value === 'available' ? '已有资料' : '等待补充'}`
            : '',
        ],
      ];
      for (const [key, label] of labels) {
        if (!label) continue;
        const button = document.createElement('button');
        button.type = 'button';
        button.dataset.clearFilter = key;
        button.textContent = `${label} ×`;
        button.setAttribute('aria-label', `清除${label}`);
        activeFilters.append(button);
      }
    }

    function applyFilters(updateHistory = true) {
      const terms = normalize(queryInput.value).split(/\s+/).filter(Boolean);
      const major = majorSelect.value;
      const semester = semesterSelect.value;
      const category = categorySelect.value;
      const status = statusSelect.value;

      const visible = cards.filter((card) => {
        const search = card.dataset.search ?? '';
        const termMatch = terms.every((term) => search.includes(term));
        const majorMatch = !major || (card.dataset.majors ?? '').split('|').includes(major);
        const semesterMatch =
          !semester || (card.dataset.semesters ?? '').split('|').includes(semester);
        const categoryMatch =
          !category || (card.dataset.categories ?? '').split('|').includes(category);
        const statusMatch = !status || card.dataset.status === status;
        const matches = termMatch && majorMatch && semesterMatch && categoryMatch && statusMatch;
        card.hidden = !matches;
        return matches;
      });

      const sort = sortSelect.value;
      const collator = new Intl.Collator('zh-CN', { numeric: true, sensitivity: 'base' });
      cards.sort((a, b) => {
        if (sort === 'name') return collator.compare(a.dataset.name ?? '', b.dataset.name ?? '');
        if (sort === 'code') return collator.compare(a.dataset.code ?? '', b.dataset.code ?? '');
        return Number(b.dataset.files ?? 0) - Number(a.dataset.files ?? 0)
          || collator.compare(a.dataset.name ?? '', b.dataset.name ?? '');
      });
      for (const card of cards) list.append(card);

      count.textContent = String(visible.length);
      hint.textContent = sort === 'resources'
        ? '资料较多的课程优先显示'
        : sort === 'code'
          ? '按课程代码排序'
          : '按课程名称排序';
      empty.hidden = visible.length !== 0;
      list.hidden = visible.length === 0;
      renderActiveFilters();
      if (updateHistory) updateUrl();
    }

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      applyFilters();
    });
    form.addEventListener('input', () => applyFilters());
    form.addEventListener('change', () => applyFilters());
    form.addEventListener('reset', () => {
      requestAnimationFrame(() => {
        sortSelect.value = 'resources';
        applyFilters();
      });
    });
    explorer.querySelector('[data-clear-query]')?.addEventListener('click', () => {
      queryInput.value = '';
      queryInput.focus();
      applyFilters();
    });
    explorer.querySelector('[data-empty-reset]')?.addEventListener('click', () => {
      form.reset();
      sortSelect.value = 'resources';
      applyFilters();
      queryInput.focus();
    });
    activeFilters.addEventListener('click', (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-clear-filter]');
      if (!button) return;
      const key = button.dataset.clearFilter as keyof typeof controls;
      controls[key].value = key === 'sort' ? 'resources' : '';
      applyFilters();
    });
    window.addEventListener('popstate', () => {
      hydrateFromUrl();
      applyFilters(false);
    });

    hydrateFromUrl();
    applyFilters(false);
  }
</script>
