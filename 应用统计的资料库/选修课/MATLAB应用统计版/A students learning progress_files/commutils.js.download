var _utils = {
    domain : {},
};

_utils.domain.getDomain = function (domain) {
    var begin = document.domain.indexOf(".");
    return domain.substring(begin + 1);
};

/**
 * 设置domain
 */
_utils.domain.setDomain = function () {
    var hostname = window.location.host;
    if(hostname == "smartcourse.hust.edu.cn"){
        document.domain = "smartcourse.hust.edu.cn";
        return;
    }
    if(hostname == "pan-yz.mooc.zhihui-yun.com") {
        document.domain = "zhihui-yun.com";
        return;
    }
    if (hostname == 'pan-yz.emooc.xidian.edu.cn') {
        document.domain = "emooc.xidian.edu.cn";
        return;
    }
    if(hostname == "pan-yz.ppsuc.edu.cn"){
        document.domain = "ppsuc.edu.cn";
        return;
    }
    if (hostname.indexOf("ecust.edu.cn") != -1) {
        document.domain = "ecust.edu.cn";
        return;
    }
    var index = hostname.indexOf("pan-yz.");
    if (index >= 0) {
        document.domain = hostname.replace("pan-yz.", "");
        return;
    }
    var index = hostname.indexOf("pan.ananas.");
    if (index >= 0) {
        document.domain = hostname.replace("pan.ananas.", "");
        return;
    }
    var index = hostname.indexOf("test.pan.");
    if (index >= 0) {
        document.domain = hostname.replace("test.pan.", "");
        return;
    }
    var re = /\./g;
    var domain = window.document.domain;
    if (document.domain.match(re).length > 1) {
        try {
            domain = _utils.domain.getDomain(domain);
            document.domain = domain;
        } catch (e) {
            try {
                domain = _utils.domain.getDomain(domain);
                document.domain = domain;
            } catch (e) {
                console.log(e)
            }
        }
    }
};
_utils.domain.setDomain();