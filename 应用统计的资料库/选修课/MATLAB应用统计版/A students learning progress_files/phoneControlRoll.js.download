function controlRoll(obj) {
    var pageSize = 1;
    var optNo = 0;//操作序号
    window.addEventListener('message', function (e) {
        var messageData = {};
        if (!!e.data) {
            if (e.data instanceof Object) {
                messageData = e.data;
            }else {
                messageData = JSON.parse(e.data);
            }
        }
        if(!!window.console){        	
        	console.log("资源投屏页面收到message消息：" + JSON.stringify(messageData));
        }
        var cmd = messageData.cmd;
        if(cmd=="forwardMessageToScreen"){
            try{
                return controlMyScreenPage(messageData.content.screenData);
            }catch (error){}
        }
        if (cmd == "resScroll") {//页面滚动  按照百分比模式  由客户端传百分比
            var direction = messageData.content.direction;
            if(typeof (obj) != "undefined" && obj != null&&obj.indexOf("iframe")>-1){
                //当所要控制的页面时iframe时候，将messageData传给所要控制的页面，让他自己去实现方法控制
                try{
                    return controlMyIframeRoll(messageData);
                }catch (error){}
            }
            if (typeof (obj) == "undefined" || obj == null) {//控制的是body
                var bodyHeight = document.body.scrollHeight;
                var currentHeight = window.scrollY;
                if(typeof (currentHeight)=="undefined"){
                    currentHeight = window.pageYOffset;//IE 浏览器没有scrollY属性
                }
                if (direction != "undefined" && parseInt(direction) == 0) {//往下滑
                    currentHeight += 350;
                    window.scrollTo(1, currentHeight);
                } else if (direction != "undefined" && parseInt(direction) == 1) {//往上滑
                    currentHeight -= 350;
                    if (currentHeight < 0) {
                        currentHeight = 0;
                    }
                    window.scrollTo(1, currentHeight);
                } else if (direction != "undefined" && parseInt(direction) == 2) {//手机传参百分比滑动
                    var percent = messageData.content.percent;
                    var optNoNew = messageData.content.optNo;
                    if (optNoNew > optNo) {
                    	if(!!window.console){                    		
                    		console.log("操作有效");
                    	}
                        optNo = optNoNew;
                        var bodyHeight = document.body.scrollHeight;
                        var currentHeight = window.scrollY;
                        currentHeight = bodyHeight * Number(percent);
                        window.scrollTo(1, currentHeight);
                    }
                } else if (direction != "undefined" && parseInt(direction) == 3) {//页面缩小
                    pageSize -= 0.2;
                    if (pageSize <= 0.2) {
                        pageSize = 0.2;
                    }
                    document.body.style.zoom = pageSize;
                } else if (direction != "undefined" && parseInt(direction) == 4) {//页面放大
                    pageSize += 0.2;
                    document.body.style.zoom = pageSize;
                }
            }else{//控制某个div或者。。。
                var divHeight;
                var currentHeight;
                if(obj.indexOf(".")>-1){
                     divHeight = $(obj)[0].scrollHeight;
                     currentHeight = $(obj).scrollTop();
                }
                if(obj.indexOf("#")>-1){
                    divHeight = $(obj)[0].scrollHeight;
                    currentHeight = $(obj).scrollTop();
                }
                if (direction != "undefined" && parseInt(direction) == 0) {//往下滑
                	if((currentHeight+$(obj).height())>=divHeight){
                		return;
                	}
                    currentHeight += 350;
                    $(obj).scrollTop(currentHeight);
                } else if (direction != "undefined" && parseInt(direction) == 1) {//往上滑
                    currentHeight -= 350;
                    if (currentHeight < 0) {
                        currentHeight = 0;
                    }
                    $(obj).scrollTop(currentHeight);
                } else if (direction != "undefined" && parseInt(direction) == 2) {//手机传参百分比滑动
                    var percent = messageData.content.percent;
                    var optNoNew = messageData.content.optNo;
                    if (optNoNew > optNo) {
                    	if(!!window.console){                    		
                    		console.log("操作有效");
                    	}
                        optNo = optNoNew;
                        currentHeight = divHeight * Number(percent);
                        $(obj).scrollTop(currentHeight);
                    }
                } else if (direction != "undefined" && parseInt(direction) == 3) {//页面缩小
                    pageSize -= 0.2;
                    if (pageSize <= 0.2) {
                        pageSize = 0.2;
                    }
                    document.body.style.zoom = pageSize;
                } else if (direction != "undefined" && parseInt(direction) == 4) {//页面放大
                    pageSize += 0.2;
                    document.body.style.zoom = pageSize;
                }
            }
        }
        if(cmd=="resScrollByOneSpeed"){//手机控制大屏端匀速滑动
            var direction = messageData.content.direction;
            console.log("direction为"+direction)
            console.log("currentDirection为"+currentDirection)
            //判断当前方向和上一次方向是否一致
            if(direction != "undefined" && parseInt(direction) != currentDirection){//如果不一致就先停止
                stopMove();
                currentDirection=direction;
            }else {//如果这次移动方向和上次一样，就不做操作
                clearDelay();
                return;
            }

            if(typeof (obj) != "undefined" && obj != null&&obj.indexOf("iframe")>-1){
                //当所要控制的页面时iframe时候，将messageData传给所要控制的页面，让他自己去实现方法控制
                try{
                    return controlMyIframeRoll(messageData);
                }catch (error){}
            }
            if (typeof (obj) == "undefined" || obj == null) {//控制的是body
                var bodyHeight = document.body.scrollHeight;
                var currentHeight = window.scrollY;
                if(typeof (currentHeight)=="undefined"){
                    currentHeight = window.pageYOffset;//IE 浏览器没有scrollY属性
                }if (direction != "undefined" && parseInt(direction) == -1) {//立马停止移动
                    stopMove();
                } else if (direction != "undefined" && parseInt(direction) == 0) {//往下滑
                    movePageTimer=setInterval(function(){
                        currentHeight=currentHeight+speed;
                        window.scrollTo(1, currentHeight);
                    },timeSecond);
                    movePageTimerArray=movePageTimerArray.concat(movePageTimer);
                    //2秒后结束滑动
                    //先将之前的延时结束定时器删除
                    clearDelay();
                } else if (direction != "undefined" && parseInt(direction) == 1) {//往上滑
                    movePageTimer=setInterval(function(){
                        currentHeight=currentHeight-speed;
                        if (currentHeight < 0) {
                            currentHeight = 0;
                        }
                        window.scrollTo(1, currentHeight);
                    },timeSecond);
                    movePageTimerArray=movePageTimerArray.concat(movePageTimer);
                    //2秒后结束滑动
                    //先将之前的延时结束定时器删除
                    clearDelay();
                }else if(direction != "undefined" && parseInt(direction) == 2){//根据百分比来滑动
                    var percent = messageData.content.percent;
                    var optNoNew = messageData.content.optNo;
                    if (optNoNew > optNo) {
                        if(!!window.console){
                            console.log("操作有效");
                        }else{
                            return;
                        }
                        optNo = optNoNew;
                       var  newCurrentHeight = bodyHeight * Number(percent);
                       var currentDiff = newCurrentHeight -currentHeight;
                       //每 timeSecond（100ms） 滑动 speed (50px)
                        //计算需要滑动的毫秒数
                        var stopTimeSecond =Math.abs(Math.ceil(currentDiff/speed)*100);
                       if(currentDiff>0){//向下滑动
                           movePageTimer=setInterval(function(){
                               currentHeight=currentHeight+speed;
                               window.scrollTo(1, currentHeight);
                           },timeSecond);
                           movePageTimerArray=movePageTimerArray.concat(movePageTimer);
                           //stopTimeSecond秒后结束滑动
                           //先将之前的延时结束定时器删除
                           clearDelay(stopTimeSecond);
                       }else{//向上滑动
                           movePageTimer=setInterval(function(){
                               currentHeight=currentHeight-speed;
                               if (currentHeight < 0) {
                                   currentHeight = 0;
                               }
                               window.scrollTo(1, currentHeight);
                           },timeSecond);
                           movePageTimerArray=movePageTimerArray.concat(movePageTimer);
                           //2秒后结束滑动
                           //先将之前的延时结束定时器删除
                           clearDelay(stopTimeSecond);
                       }
                    }
                }
            }else{//控制某个div或者。。。
                var divHeight;
                var currentHeight;
                if(obj.indexOf(".")>-1){
                    divHeight = $(obj)[0].scrollHeight;
                    currentHeight = $(obj).scrollTop();
                }
                if(obj.indexOf("#")>-1){
                    divHeight = $(obj)[0].scrollHeight;
                    currentHeight = $(obj).scrollTop();
                }
                if (direction != "undefined" && parseInt(direction) == -1) {//立马停止移动
                    stopMove();
                } else if (direction != "undefined" && parseInt(direction) == 0) {//往下滑
                	if((currentHeight+$(obj).height())>=divHeight){
                		stopMove();
                		return;
                	}
                    movePageTimer=setInterval(function(){
                        currentHeight=currentHeight+speed;
                        $(obj).scrollTop(currentHeight);
                        if((currentHeight+$(obj).height())>=divHeight){
                    		stopMove();
                    		return;
                    	}
                    },timeSecond);
                    movePageTimerArray=movePageTimerArray.concat(movePageTimer);
                    clearDelay();
                } else if (direction != "undefined" && parseInt(direction) == 1) {//往上滑
                    movePageTimer=setInterval(function(){
                        currentHeight=currentHeight-speed;
                        if (currentHeight < 0) {
                            currentHeight = 0;
                        }
                        $(obj).scrollTop(currentHeight);
                    },timeSecond);
                    movePageTimerArray=movePageTimerArray.concat(movePageTimer);
                    clearDelay();
                }else if(direction != "undefined" && parseInt(direction) == 2) {//根据百分比滑动
                    var percent = messageData.content.percent;
                    var optNoNew = messageData.content.optNo;
                    if (optNoNew > optNo) {
                        if(!!window.console){
                            console.log("操作有效");
                        }else{
                            return;
                        }
                        optNo = optNoNew;
                        var  newCurrentHeight = bodyHeight * Number(percent);
                        var currentDiff = newCurrentHeight -currentHeight;
                        //每 timeSecond（100ms） 滑动 speed (50px)
                        //计算需要滑动的毫秒数
                        var stopTimeSecond =Math.abs(Math.ceil(currentDiff/speed)*100);
                        if(currentDiff>0){//向下滑动
                            movePageTimer=setInterval(function(){
                                currentHeight=currentHeight+speed;
                                $(obj).scrollTop(currentHeight);
                            },timeSecond);
                            movePageTimerArray=movePageTimerArray.concat(movePageTimer);
                            //stopTimeSecond秒后结束滑动
                            //先将之前的延时结束定时器删除
                            clearDelay(stopTimeSecond);
                        }else{//向上滑动
                            movePageTimer=setInterval(function(){
                                currentHeight=currentHeight-speed;
                                if (currentHeight < 0) {
                                    currentHeight = 0;
                                }
                                $(obj).scrollTop(currentHeight);
                            },timeSecond);
                            movePageTimerArray=movePageTimerArray.concat(movePageTimer);
                            //2秒后结束滑动
                            //先将之前的延时结束定时器删除
                            clearDelay(stopTimeSecond);
                        }
                    }
                }
            }
        }
    });
}
var speed=50;//每次移动的距离px
var timeSecond =100;//间隔时间
var movePageTimer;
var movePageTimerArray=[0];//保存定时移动的timer
var stopMovePageTimer;
var stopMovePageTimerArray=[0];//保存延时清楚定时移动的timer
var currentDirection=-1;//存储当前移动的方向

//清楚定时移动的timer
function stopMove(){
    for(var i=0;i<movePageTimerArray.length;i++){
        try{
            clearInterval(movePageTimerArray[i]);
        }catch (error){}
    }
    //清除完后重新初始化
    movePageTimerArray=[0];
    currentDirection=-1;
}
//清除控制延时移动的timer
function clearDelay(stopTimeSecond){
    if(stopTimeSecond=="undefined"||(typeof stopTimeSecond)=="undefined" ){
        stopTimeSecond=2000;
    }
    //2秒后结束滑动
    //先将之前的延时结束定时器删除
    for(var i=0;i<stopMovePageTimerArray.length;i++){
        try{
            clearInterval(stopMovePageTimerArray[i]);
        }catch (error){}
    }
    stopMovePageTimerArray=[0];
    stopMovePageTimer = setTimeout(stopMove,stopTimeSecond);
    stopMovePageTimerArray = stopMovePageTimerArray.concat(stopMovePageTimer);
}


