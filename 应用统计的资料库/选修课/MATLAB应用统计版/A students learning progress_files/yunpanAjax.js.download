var yunpanAjax = {};

yunpanAjax.getJSON = function () {
    var argumentsArray = arguments;
    if (argumentsArray.length == 3) {
        yunpanAjax.ajax({
            type: 'GET',
            url: argumentsArray[0],
            data: argumentsArray[1],
            success: argumentsArray[2]
        })
    } else {
        yunpanAjax.ajax({
            type: 'GET',
            url: argumentsArray[0],
            success: argumentsArray[1]
        })
    }
};

yunpanAjax.get = function (url, param, success) {
    var argumentsArray = arguments;
    if (argumentsArray.length == 3) {
        yunpanAjax.ajax({
            type: 'GET',
            url: argumentsArray[0],
            data: argumentsArray[1],
            success: argumentsArray[2]
        })
    } else {
        yunpanAjax.ajax({
            type: 'GET',
            url: argumentsArray[0],
            success: argumentsArray[1]
        })
    }
};

yunpanAjax.post = function (url, params, success, dataType) {
    var argumentsArray = arguments;
    if (argumentsArray.length == 3) {
        yunpanAjax.ajax({
            type: 'POST',
            url: argumentsArray[0],
            success: argumentsArray[1]
        })
    }
    if (argumentsArray.length == 4) {
        yunpanAjax.ajax({
            type: 'POST',
            url: argumentsArray[0],
            data: argumentsArray[1],
            success: argumentsArray[2]
        })
    }
}

yunpanAjax.ajax = function (obj) {
    if (obj.dataType == undefined) {
        obj.dataType = 'JSON';
    }
    if (obj.async == undefined) {
        obj.async = true;
    }
    if (obj.processData == undefined) {
        obj.processData = true;
    }
    if(obj.contentType == undefined){
        obj.contentType = "application/x-www-form-urlencoded";
    }
    $.ajax({
        type: obj.type,
        url: obj.url,
        data: obj.data,
        dataType: obj.dataType,
        async: obj.async,
        processData: obj.processData,
        contentType: obj.contentType,
        beforeSend: function (xhr) {
            xhr.setRequestHeader("p-auth-token", p_auth_token);
        },
        success: obj.success,
        error: obj.error
    });
}

yunpanAjax.ajaxPost = function (url, formData, async, backFunction) {
    yunpanAjax.ajax({
        type: "POST",
        url: url,
        dataType: 'JSON',
        data: formData,
        async: async,
        cache: false,
        processData: false,
        contentType: false,
        success: function (data) {
            backFunction(data);
        },
        error: function (error) {
            console.log(error);
        }
    });
};