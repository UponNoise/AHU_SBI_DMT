function greenligth() {
	var ua  = navigator.userAgent;
	if ((ua.indexOf('ChaoXingStudy') > -1 && ua.indexOf("_pc_") < 0) || ua.indexOf('iPhone') > -1 || ua.indexOf('Android') > -1 || ua.indexOf('yiban') > -1 || ua.indexOf('weishao') > -1) {
		try {
			var parent = Ext.get(window.frameElement).parent();
			parent.addCls('ans-job-finished');
			//parent.query('.ans-job-icon')[0].innerHTML = '任务点已完成';
			parent.dom.children[0].innerHTML = '<span class="job-color"></span>' + langMap.taskPointCompleteText;
			window.parent.scrollTo(0, parent.getTop());
		} catch (e) {
			console && console.log('greenligth: ', e);
		}
	} else {
		Ext.get(window.frameElement).parent().addCls('ans-job-finished');
	}

	try {
		if(top.refreshScroll) {
			top.refreshScroll();
		}
	}catch (ex) {
		console.log(ex)
	}
}

if (ed_complete) {
	Ext.Function.interceptAfter(window, "ed_complete", function() {
		greenligth();
	});
}

var setting = parent.AttachmentSetting, 
iframe = window.frameElement, 
data = Ext.decode(iframe.getAttribute('data')), 
courseid =parent.courseid, 
_mid = data.mid, 
ut = 't';
jobid = typeof data.jobid !== 'undefined' ? data.jobid : '';

if (setting && setting.control) {
	var attachments = setting.attachments;
	if (setting.defaults && setting.defaults.knowledgeid) {
		clazzId = setting.defaults.clazzId || '', 
		knowledgeid = setting.defaults.knowledgeid || '',
		courseid = setting.defaults.courseid ? setting.defaults.courseid : '';
		try{
			ut  = (top.location.pathname.indexOf('teacherstudy') != -1 || top.location.pathname.indexOf('mycourse/tch') != -1) || (top.location.href.indexOf("course/phone/chapterdata") > -1) ? 't' : 's';
		}catch (e) {
		}
	}

	var enc = '';
	for (var i = 0; i < attachments.length; i++) {
		m = attachments[i];
		if (_mid == m.property.mid && m.enc) {
			enc = m.enc;
		}
	}
}

function isJob() {
	if (setting && setting.attachments && setting.defaults.clazzId) {
		if (jobid.length == 0) {
			return false;
		}
		var attachments = setting.attachments;
		for ( var index in attachments) {
			var item = attachments[index];
			var itemJobid = typeof item.jobid !== 'undefined' ? item.jobid : '';
			if (itemJobid.length != 0 && itemJobid == jobid) {
				return true;
			}
		}
		return false;
	} else {
		return false
	}
}

function jobToken() {
	var jtoken = '';
	var attachments = setting.attachments;
	for ( var i in attachments) {
		var item = attachments[i];
		var itemJobid = typeof item.jobid !== 'undefined' ? item.jobid : '';
		if (itemJobid.length != 0 && itemJobid == jobid) {
			jtoken = item.jtoken;
			return jtoken;
		}
	}
	return jtoken;
}

function getMicroTopicId() {
	var microTopicId = '';
	try {
		var attachments = setting.attachments;

		for ( var i in attachments) {
			var item = attachments[i];
			var itemJobid = typeof item.jobid !== 'undefined' ? item.jobid : '';
			if (itemJobid.length != 0 && itemJobid == jobid) {
				microTopicId = item.microTopicId;
				return microTopicId;
			}
		}
	} catch (e) {
		console.log(e)
	}

	return microTopicId;
}

function getUt() {
	return ut;
}

function documentToScreen(webUrl) {
	try {
		$.ajax({
			type : "post",
			url :  "/mooc-ans/course/phone/resourceToScreen",
			data: {
				type: 2,
				opt : 1,
				url: encodeURIComponent(webUrl)
			},
			dataType : "json",
			success : function(result){
				if(data.result == 1 && data.data == 1){
					parent.window.open(webUrl, '_self');
				}else {
					console.log("投屏失败： " + data.errorMsg)
					parent.window.open(webUrl, '_self');
				}

			},failure : function(resp){
				parent.window.open(webUrl, '_self');
			}
		})
	} catch (e) {
		console.log(e);
	}
}

function finishJob(outerUrl, webUrl) {
	if(ut == 't' && webUrl){
		window.open(webUrl, '_blank');
		return;
	}
	if(!(setting && setting.defaults) && webUrl){
		window.open(webUrl, '_blank');
		return;
	}
	var isFiled = setting.defaults.isFiled;
	var state = setting.defaults.state;
	if (isFiled == 1 || state == 1) {
		return;
	}

	if(webUrl && !isJob()) {
		window.open(webUrl, '_blank');
		return;
	}

	if (setting && setting.control && ut == 's' && isJob()) {
        var url = "/ananas/job/document?jobid={0}&knowledgeid={1}&courseid={2}&clazzid={3}&jtoken={4}&checkMicroTopic={5}&microTopicId={6}";
        if(outerUrl){
        	url = outerUrl;
        }
		var jtoken = jobToken();
		var microTopicId = getMicroTopicId();
		var o = setting.defaults;
		var url = Ext.String.format(url, jobid, o.knowledgeid, o.courseid, o.clazzId, jtoken,true,microTopicId);
		Ext.Ajax.request({
			url : url,
			async:false,
			success : function(response) {
				var r = eval('(' + response.responseText + ')');
				if (r.status) {
					greenligth();

                    ed_complete && ed_complete();
                    if(webUrl) {
						window.open(webUrl, '_blank');
					}
				}else {
					if(webUrl) {
						alert("获取任务点失败1");
					}
				}
			},
			failure : function(resp) {
				if(webUrl) {
					alert("获取任务点失败2");
				}
			}
		});
	}
}

function checkJobFinish() {
	try {
		// h5 门户访问章节,不校验任务点
		if (top.location.href.indexOf("isPortalVisit=true") > -1) {
			return true;
		}
		if (window.parent.parent.location.pathname.indexOf('teacherstudy') != -1 || window.parent.parent.location.pathname.indexOf('mycourse/tch') != -1 || window.parent.location.pathname.indexOf("/course/phone/chapterdata") != -1) {
			return false;
		}
	} catch (e) {
		return false;
	}
	if (setting && setting.control && setting.attachments && setting.defaults.clazzId) {
		if (jobid.length == 0) {
			return false;
		}
		var attachments = setting.attachments;
		for ( var index in attachments) {
			var item = attachments[index];
			var itemJobid = typeof item.jobid !== 'undefined' ? item.jobid : '';
			if (itemJobid.length != 0 && itemJobid == jobid && ! (item.job)) {
				return true;
			}
		}
		return false;
	} else {
		return false
	}
}


function hasJobToFinish() {
	if (setting && setting.control && ut == 's' && setting.attachments && setting.defaults.clazzId) {
		if (jobid.length == 0) {
			return false;
		}
		var attachments = setting.attachments;
		for ( var index in attachments) {
			var item = attachments[index];
			var itemJobid = typeof item.jobid !== 'undefined' ? item.jobid : '';
			if (itemJobid.length != 0 && itemJobid == jobid && (item.job)) {
				return true;
			}
		}
		return false;
	} else {
		return false
	}
}


function docReadControl() {
	var data = Ext.decode(window.frameElement.getAttribute('data'));
	if (setting && setting.control && ut == 's') {
		if (data.jobid || data.btime) {
			return true;
		}
	}
	return false;
}